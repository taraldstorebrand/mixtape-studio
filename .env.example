# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
SUNO_API_KEY=

# Host port the app is published on (container listens on 3001)
HOST_PORT=3001

# Host interface to publish on (0.0.0.0 = all). The app has no login.
BIND_ADDRESS=0.0.0.0

# Host user/group that owns ./data (check with: id -u / id -g)
PUID=1000
PGID=1000
